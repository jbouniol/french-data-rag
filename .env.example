# ============================================================================
# Alter-Ego · Example Environment Configuration
# Copy to .env and paste your OpenRouter API key for the
# Local (Ollama) vs Cloud API (OpenRouter) comparison.
# ============================================================================

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=

# Local Ollama configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
HF_HUB_DISABLE_XET=1
