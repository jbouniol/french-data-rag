# ============================================================================
# Alter-Ego · Example Environment Configuration
# Copy to .env and paste your OpenRouter API key for the
# Local (Ollama) vs Cloud API (OpenRouter) comparison.
# ============================================================================

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=
API_MODEL=google/gemini-2.5-flash

# Local Ollama configuration (default in src/agent/llm.py: gemma4:e4b-it-qat; alternative: gemma4:12b)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b-it-qat
HF_HUB_DISABLE_XET=1
